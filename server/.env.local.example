# Local server env for payment testing
# Copy: cp server/.env.local.example server/.env

NODE_ENV=development
PORT=8787
DASHBOARD_ORIGIN=http://localhost:5173
ADDITIONAL_CORS_ORIGINS=http://localhost:5173
EXTENSION_ORIGIN=chrome-extension://

# Supabase - licenses table ke liye zaroori production me
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option 1 (easy): static Razorpay payment link
RAZORPAY_PAYMENT_LINK_URL=

# Option 2 (advanced): dynamic Razorpay links + webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RAZORPAY_AMOUNT_PAISE=5000
RAZORPAY_CURRENCY=INR

# Paid users ko ye code doge (comma se multiple codes)
LICENSE_UNLOCK_CODES=SCOUT50-CHANGE-ME

# AI optional - bina iske bhi extension fallback mode me chalega
OPENAI_API_KEY=
