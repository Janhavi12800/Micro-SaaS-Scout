# Render Backend Environment Variables
NODE_ENV=production
PORT=10000

# Replace after Vercel gives you the real dashboard URL.
DASHBOARD_ORIGIN=https://micro-saas-scout.vercel.app
ADDITIONAL_CORS_ORIGINS=https://micro-saas-scout.vercel.app

# Before Chrome Web Store publishing you can leave CHROME_EXTENSION_ID blank.
# After publishing, set it to your extension ID for stricter CORS.
EXTENSION_ORIGIN=chrome-extension://
CHROME_EXTENSION_ID=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
FREE_ANALYSIS_LIMIT=5

# AI providers. Add at least one for live AI; otherwise demo mode works.
OPENAI_API_KEY=sk_replace_me
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase - service role key stays on Render only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Clerk
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
